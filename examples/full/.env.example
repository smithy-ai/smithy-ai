# =============================================================================
# Smithy-AI Deployment Configuration
# =============================================================================
# Copy to .env and fill in your values:   cp .env.example .env
# Required fields are marked [REQUIRED].
# =============================================================================

# --- Hostname -----------------------------------------------------------------
# [REQUIRED] Public hostname for HTTPS (Caddy auto-provisions Let's Encrypt cert)
SMITHY_HOST=smithy.example.com

# --- GitLab secrets -----------------------------------------------------------
# Non-secret GitLab settings are in config/orchestrator.yml.
# [REQUIRED] Access tokens for the bot users
SMITHY_GITLAB_TOKEN=
ARCHITECT_GITLAB_TOKEN=
# [REQUIRED] HMAC secret for verifying GitLab webhook signatures
GITLAB_WEBHOOK_SECRET=

# --- Claude -------------------------------------------------------------------
# [REQUIRED] Authenticate with EITHER an OAuth token OR an Anthropic API key.
# OAuth token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# --- Dashboard ----------------------------------------------------------------
# bcrypt hash of the admin password. If unset, a random password is generated on startup.
# ADMIN_PASSWORD_HASH=

# --- Image Version ------------------------------------------------------------
# Tag for orchestrator and knowledgebase images: "dev", "latest", or a semver
IMAGE_TAG=dev

# --- Knowledgebase (optional) -------------------------------------------------
# Uncomment the profile and set the knowledgebase service's own secrets to enable it.
# COMPOSE_PROFILES=knowledgebase
# OPENAI_API_KEY=
# KB_VCS_URL=
# KB_VCS_TOKEN=        # same as SMITHY_GITLAB_TOKEN or SMITHY_FORGEJO_TOKEN
# KB_WEBHOOK_SECRET=   # same as GITLAB_WEBHOOK_SECRET or WEBHOOK_SECRET
