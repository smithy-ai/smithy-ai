# Python __pycache__/ *.py[cod] *$py.class *.egg-info/ *.egg dist/ .venv/ venv/

# Java / Gradle
.gradle/
build/

# Node
node_modules/
*.tsbuildinfo

# Environment. Every variant of it: a filled-in .env under another name is
# still full of tokens, and .env.example is the only one meant to be committed.
.env
.env.*
!.env.example

